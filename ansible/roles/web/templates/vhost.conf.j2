<VirtualHost *:80>
    ServerName {{ dominio }}
    DocumentRoot {{ app_dir }}

    <Directory {{ app_dir }}>
        Require all granted
        AllowOverride All
    </Directory>

    # Apache no ejecuta los .php: los reenvía a PHP-FPM en la máquina php
    <FilesMatch "\.php$">
        SetHandler "proxy:fcgi://{{ ip_php_datos }}:9000"
    </FilesMatch>

    ErrorLog ${APACHE_LOG_DIR}/guestbook_error.log
    CustomLog ${APACHE_LOG_DIR}/guestbook_access.log combined
</VirtualHost>
