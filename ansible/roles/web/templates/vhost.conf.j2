<VirtualHost *:80>
    ServerName {{ dominio }}
    DocumentRoot {{ app_dir }}

    <Directory {{ app_dir }}>
        Require all granted
        AllowOverride All
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/guestbook_error.log
    CustomLog ${APACHE_LOG_DIR}/guestbook_access.log combined
</VirtualHost>
