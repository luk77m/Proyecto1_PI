global
    log /dev/log local0
    chroot /var/lib/haproxy
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option redispatch
    retries 3
    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend entrada
    bind *:80
    default_backend webs

backend webs
    balance roundrobin
{% for h in groups['servidores_web'] %}
    server {{ h }} {{ hostvars[h].ip_datos }}:80 check inter 2s fall 2 rise 2
{% endfor %}
